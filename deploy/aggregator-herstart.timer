[Unit]
Description=Nachtelijke herstart van de reisplan-aggregator (03:00 Nederlandse tijd)

[Timer]
# De VM staat op UTC; de zone staat hier expliciet zodat het 03:00 Nederlandse
# tijd blijft over de zomertijdgrens heen (01:00 UTC in de zomer, 02:00 in de
# winter). systemd >= 250 vereist voor de zone-notatie; de VM draait 252.
OnCalendar=*-*-* 03:00:00 Europe/Amsterdam
# Niet inhalen na downtime: een gemiste herstart alsnog uitvoeren bij het
# opstarten is zinloos, want dan is het proces net begonnen.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
