[Unit]
Description=Reisplan statische data vernieuwen (feeds -> merge -> segments)
# De aggregator leest merged.duckdb alleen bij start; na verversing herstarten we hem.
# De stappen staan in deploy/vernieuw.sh zodat ze via git pull mee-updaten.

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/bin/bash @REPO@/deploy/vernieuw.sh
ExecStartPost=+/usr/bin/systemctl restart reisplan-aggregator.service
